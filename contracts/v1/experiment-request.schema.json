{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentRequest v1",
  "type": "object",
  "required": ["experiment_id", "benchmark_version", "treatments", "repetitions", "seed", "budget"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{8,64}$"},
    "benchmark_version": {"type": "string", "minLength": 1},
    "treatments": {"type": "array", "minItems": 1},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 1000},
    "seed": {"type": "integer"},
    "budget": {"type": "object", "required": ["max_tokens", "max_cost_usd", "max_wall_time_seconds"]}
  },
  "additionalProperties": false
}
